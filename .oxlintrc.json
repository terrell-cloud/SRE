{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/engine/**/*.ts", "src/gen/**/*.ts", "src/data/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["react", "react-dom", "react/*", "react-dom/*", "zustand", "zustand/*", "idb-keyval"],
                "message": "src/engine, src/gen and src/data must stay pure: no UI, state or storage imports. Functions take data + Rng and return data."
              },
              {
                "group": ["../ui/*", "../state/*", "../save/*", "../scenes/*", "**/ui/**", "**/state/**", "**/save/**", "**/scenes/**"],
                "message": "The simulation core cannot depend on UI, state stores, save layer or scenes."
              }
            ]
          }
        ]
      }
    }
  ]
}
