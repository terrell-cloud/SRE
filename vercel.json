{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/about-us",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/services/roof-replacement",
      "destination": "/services/residential-roofing/",
      "permanent": true
    },
    {
      "source": "/service-areas/fort-oglethorpe-ga",
      "destination": "/service-areas/fort-oglethorpe-ga/",
      "permanent": true
    },
    {
      "source": "/service-areas/dalton-ga",
      "destination": "/service-areas/dalton-ga/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
