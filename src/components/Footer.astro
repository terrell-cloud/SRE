---
import { siteConfig } from '@data/siteConfig';
import { services } from '@data/services';
import { cities } from '@data/cities';
import Logo from '@components/Logo.astro';

const year = new Date().getFullYear();
---

<footer class="bg-brand-900 text-brand-100">
  <div class="container-site grid gap-10 px-4 py-14 sm:grid-cols-2 lg:grid-cols-4 lg:px-8">
    <div>
      <Logo class="h-12 w-auto" light />
      <p class="mt-4 text-sm leading-relaxed text-brand-100/80">
        Locally owned and operated in Dalton, Georgia. Residential and commercial roofing,
        siding, windows, and gutters across {siteConfig.serviceRegion}.
      </p>
      <p class="mt-4 text-sm text-brand-100/80">
        A percentage of every job goes to a charity chosen by our customer.
      </p>
    </div>

    <div>
      <h2 class="font-display text-lg font-bold uppercase tracking-wide text-white">Services</h2>
      <ul class="mt-4 space-y-2">
        {services.map((s) => (
          <li>
            <a href={`/services/${s.slug}/`} class="text-brand-100/90 hover:text-white hover:underline">
              {s.shortName}
            </a>
          </li>
        ))}
        <li>
          <a href="/free-inspection/" class="font-semibold text-white hover:underline">Free Roof Inspection</a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="font-display text-lg font-bold uppercase tracking-wide text-white">Areas We Serve</h2>
      <ul class="mt-4 grid grid-cols-2 gap-x-3 gap-y-2">
        {cities.map((c) => (
          <li>
            <a href={`/service-areas/${c.slug}/`} class="text-brand-100/90 hover:text-white hover:underline">
              {c.name}, {c.state}
            </a>
          </li>
        ))}
      </ul>
      <a href="/service-areas/" class="mt-3 inline-block text-sm font-semibold text-white hover:underline">
        All service areas →
      </a>
    </div>

    <div>
      <h2 class="font-display text-lg font-bold uppercase tracking-wide text-white">Contact</h2>
      <address class="mt-4 not-italic leading-relaxed text-brand-100/90">
        {siteConfig.legalName}<br />
        {siteConfig.address.street}<br />
        {siteConfig.address.city}, {siteConfig.address.state} {siteConfig.address.zip}
      </address>
      <p class="mt-3">
        <a href={`tel:${siteConfig.phone.e164}`} class="font-display text-xl font-bold text-white hover:underline">
          {siteConfig.phone.display}
        </a>
      </p>
      <p class="mt-1">
        <a href={`mailto:${siteConfig.email}`} class="text-brand-100/90 hover:text-white hover:underline">
          {siteConfig.email}
        </a>
      </p>
      <p class="mt-3 text-sm text-brand-100/80">
        {siteConfig.hours[0].days}: {siteConfig.hours[0].display}<br />
        {siteConfig.hours[1].days}: {siteConfig.hours[1].display}
      </p>
      <p class="mt-3 text-sm text-brand-100/80">Licensed &amp; insured.</p>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-site flex flex-col items-center justify-between gap-2 px-4 py-5 text-sm text-brand-100/60 sm:flex-row lg:px-8">
      <p>© {year} {siteConfig.legalName}. All rights reserved.</p>
      <div class="flex gap-5">
        <a href={siteConfig.social.facebook} rel="noopener" class="hover:text-white">Facebook</a>
        <a href="/privacy-policy/" class="hover:text-white">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>
