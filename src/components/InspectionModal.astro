---
import { siteConfig } from '@data/siteConfig';

const calendarUrl = siteConfig.ghl.calendarUrl;
---

<dialog
  id="inspection-modal"
  class="m-auto w-[min(94vw,44rem)] rounded-lg p-0 shadow-2xl backdrop:bg-brand-900/70 backdrop:backdrop-blur-sm"
  aria-labelledby="inspection-modal-title"
>
  <div class="flex items-center justify-between gap-4 bg-brand-900 px-5 py-4">
    <h2 id="inspection-modal-title" class="font-display text-2xl font-bold text-white">
      Schedule Your Free Inspection
    </h2>
    <button
      type="button"
      class="rounded-md p-1.5 text-white/80 hover:bg-white/10 hover:text-white"
      data-close-inspection
      aria-label="Close"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
    </button>
  </div>

  <div class="bg-stone-warm-50 p-4">
    {
      calendarUrl ? (
        <div data-ghl-calendar data-src={calendarUrl} class="h-[70vh] min-h-96">
          <div class="flex h-full items-center justify-center text-brand-700">Loading calendar…</div>
        </div>
      ) : (
        <div class="px-4 py-10 text-center">
          <p class="text-lg text-brand-800">
            Pick a time that works for you — it takes about a minute by phone.
          </p>
          <a href={`tel:${siteConfig.phone.e164}`} class="btn-cta mt-6">
            Call {siteConfig.phone.display}
          </a>
          <p class="mt-4 text-sm text-brand-700/80">
            {siteConfig.hours[0].days}: {siteConfig.hours[0].display} · Free &amp; no obligation
          </p>
        </div>
      )
    }
  </div>
</dialog>
