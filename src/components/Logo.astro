---
/**
 * Official SRE logo (pulled from Drive: Logos/Designs). The light variant
 * swaps the gray lettering to white for dark backgrounds.
 */
import { Image } from 'astro:assets';
import logoFull from '@images/brand/logo-full.png';
import logoLight from '@images/brand/logo-light.png';

interface Props {
  class?: string;
  /** Light variant for dark footers */
  light?: boolean;
}
const { class: className, light = false } = Astro.props;
---

<Image
  src={light ? logoLight : logoFull}
  alt="Southern Roofing & Exteriors"
  class={className}
  widths={[240, 480]}
  sizes="240px"
  loading="eager"
/>
