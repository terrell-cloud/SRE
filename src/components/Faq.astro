---
import type { Faq } from '@data/types';

interface Props {
  faqs: Faq[];
  heading?: string;
}
const { faqs, heading = 'Frequently Asked Questions' } = Astro.props;
---

<section class="container-site section-pad">
  <h2 class="font-display text-3xl font-bold text-brand-900 md:text-4xl">{heading}</h2>
  <div class="mt-6 divide-y divide-stone-warm-200 rounded-lg border border-stone-warm-200 bg-white">
    {
      faqs.map((faq) => (
        <details class="group px-5 py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-semibold text-brand-900 [&::-webkit-details-marker]:hidden">
            {faq.q}
            <svg class="h-5 w-5 shrink-0 text-cta-600 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <p class="mt-3 leading-relaxed text-brand-800">{faq.a}</p>
        </details>
      ))
    }
  </div>
</section>
