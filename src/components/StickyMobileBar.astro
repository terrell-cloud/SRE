---
import { siteConfig } from '@data/siteConfig';
---

<div
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-px border-t border-stone-warm-200 bg-stone-warm-200 pb-[env(safe-area-inset-bottom)] md:hidden"
  aria-label="Quick contact"
>
  <a
    href={`tel:${siteConfig.phone.e164}`}
    class="flex items-center justify-center gap-2 bg-white py-4 font-display text-lg font-bold uppercase tracking-wide text-brand-900"
  >
    <svg class="h-5 w-5 text-cta-600" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.9 15.9 0 006.6 6.6l2.2-2.2a1 1 0 011-.25 11.4 11.4 0 003.6.58 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.4 11.4 0 00.58 3.6 1 1 0 01-.25 1z"/></svg>
    Call Now
  </a>
  <button
    type="button"
    class="flex items-center justify-center gap-2 bg-cta-600 py-4 font-display text-lg font-bold uppercase tracking-wide text-white"
    data-open-inspection
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18" stroke-linecap="round"/></svg>
    Book Inspection
  </button>
</div>
