---
import type { Service } from '@data/types';
import ServiceIcon from '@components/ServiceIcon.astro';

interface Props {
  service: Service;
  /** Link to a city-specific combo page instead of the main service page */
  href?: string;
}
const { service, href = `/services/${service.slug}/` } = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col rounded-lg border border-stone-warm-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-brand-500 hover:shadow-md"
>
  <span class="inline-flex h-14 w-14 items-center justify-center rounded-md bg-brand-50 text-brand-700 transition group-hover:bg-cta-600 group-hover:text-white">
    <ServiceIcon icon={service.icon} />
  </span>
  <h3 class="mt-4 font-display text-2xl font-bold text-brand-900">{service.shortName}</h3>
  <p class="mt-2 flex-1 leading-relaxed text-brand-800/90">{service.summary}</p>
  <span class="mt-4 font-semibold text-cta-600 group-hover:underline">Learn more →</span>
</a>
