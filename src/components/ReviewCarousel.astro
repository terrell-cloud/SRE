---
import type { Review } from '@data/types';
import ReviewCard from '@components/ReviewCard.astro';

interface Props {
  reviews: Review[];
  heading?: string;
}
const { reviews, heading = 'What Your Neighbors Say' } = Astro.props;
---

<section class="bg-stone-warm-50">
  <div class="container-site section-pad">
    <p class="eyebrow">Real reviews</p>
    <div class="mt-1 flex flex-wrap items-end justify-between gap-4">
      <h2 class="font-display text-3xl font-bold text-brand-900 md:text-4xl">{heading}</h2>
      <a href="/reviews/" class="font-semibold text-cta-600 hover:underline">Read all reviews →</a>
    </div>

    <div class="-mx-4 mt-8 flex snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-3 md:grid md:snap-none md:grid-cols-3 md:overflow-visible">
      {
        reviews.map((review) => (
          <div class="w-[85%] shrink-0 snap-center sm:w-[60%] md:w-auto">
            <ReviewCard review={review} />
          </div>
        ))
      }
    </div>
  </div>
</section>
