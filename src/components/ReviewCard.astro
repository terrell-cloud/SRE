---
import type { Review } from '@data/types';
import StarRating from '@components/StarRating.astro';

interface Props {
  review: Review;
}
const { review } = Astro.props;
---

<figure class="flex h-full flex-col rounded-lg border border-stone-warm-200 bg-white p-6 shadow-sm">
  <StarRating rating={review.rating} />
  <blockquote class="mt-3 flex-1 leading-relaxed text-brand-800">“{review.text}”</blockquote>
  <figcaption class="mt-4 flex items-center justify-between text-sm">
    <span class="font-semibold text-brand-900">{review.author}</span>
    <span class="text-brand-700/70">via {review.source}</span>
  </figcaption>
</figure>
