---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { siteConfig } from '@data/siteConfig';
import TrustBadges from '@components/TrustBadges.astro';

interface Props {
  title: string;
  subtitle?: string;
  image: ImageMetadata;
  imageAlt: string;
  /** 'full' for the home page, 'short' for interior pages */
  variant?: 'full' | 'short';
  eyebrow?: string;
}
const { title, subtitle, image, imageAlt, variant = 'short', eyebrow } = Astro.props;
---

<section class:list={['relative overflow-hidden bg-brand-900', variant === 'full' ? 'min-h-[70vh]' : '']}>
  <Image
    src={image}
    alt={imageAlt}
    class="absolute inset-0 h-full w-full object-cover opacity-40"
    widths={[640, 1024, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-brand-900 via-brand-900/60 to-brand-900/30" aria-hidden="true"></div>

  <div
    class:list={[
      'container-site relative px-4 lg:px-8',
      variant === 'full' ? 'flex min-h-[70vh] flex-col justify-center py-20' : 'py-14 md:py-20',
    ]}
  >
    {eyebrow && <p class="eyebrow mb-3 !text-cta-500">{eyebrow}</p>}
    <h1 class="max-w-3xl font-display text-4xl font-bold text-white md:text-6xl">{title}</h1>
    {subtitle && <p class="mt-4 max-w-2xl text-lg text-brand-100/95 md:text-xl">{subtitle}</p>}

    <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
      <button type="button" class="btn-cta" data-open-inspection>Schedule Free Inspection</button>
      <a href={`tel:${siteConfig.phone.e164}`} class="btn-ghost-light">
        Call {siteConfig.phone.display}
      </a>
    </div>

    {variant === 'full' && <div class="mt-10"><TrustBadges light /></div>}
  </div>
</section>
