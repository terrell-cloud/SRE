---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Hero from '@components/Hero.astro';
import CtaSection from '@components/CtaSection.astro';
import Faq from '@components/Faq.astro';
import ReviewCarousel from '@components/ReviewCarousel.astro';
import ProjectGallery from '@components/ProjectGallery.astro';
import { services } from '@data/services';
import { cities } from '@data/cities';
import { getCityServices, cityServices } from '@data/cityServices';
import { reviewsFor } from '@data/reviews';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@lib/schema';
import { imageOr } from '@lib/images';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;

const seo = {
  title: `${service.name} in Northwest Georgia | Southern Roofing & Exteriors`,
  description: service.metaDescription,
  path: `/services/${service.slug}/`,
};

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: service.shortName, path: `/services/${service.slug}/` },
];

const schemas = [serviceSchema(service), faqSchema(service.faqs), breadcrumbSchema(crumbs)];

const audienceLabel =
  service.audience === 'both' ? 'Residential & Commercial' : service.audience === 'residential' ? 'Residential' : 'Commercial';

// Cities with a dedicated page for this service, for local cross-links
const comboCities = cityServices
  .filter((cs) => cs.serviceSlug === service.slug)
  .map((cs) => cities.find((c) => c.slug === cs.citySlug))
  .filter((c) => c !== undefined);
---

<BaseLayout seo={seo} schemas={schemas}>
  <Hero
    title={service.name}
    subtitle={service.summary}
    eyebrow={audienceLabel}
    image={imageOr(service.heroImage, 'hero')}
    imageAlt={`${service.name} by Southern Roofing and Exteriors in Northwest Georgia`}
  />
  <Breadcrumbs crumbs={crumbs} />

  <section class="container-site section-pad !pt-8">
    <div class="max-w-3xl space-y-5">
      {service.intro.map((p) => <p class="text-lg leading-relaxed text-brand-800">{p}</p>)}
    </div>
  </section>

  <section class="bg-stone-warm-50">
    <div class="container-site section-pad">
      <h2 class="font-display text-3xl font-bold text-brand-900 md:text-4xl">What We Handle</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          service.features.map((f) => (
            <div class="rounded-lg border border-stone-warm-200 bg-white p-6">
              <h3 class="font-display text-xl font-bold text-brand-900">{f.title}</h3>
              <p class="mt-2 leading-relaxed text-brand-800/90">{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-site section-pad">
    <h2 class="font-display text-3xl font-bold text-brand-900 md:text-4xl">Our Process</h2>
    <ol class="mt-8 grid gap-8 md:grid-cols-3">
      {
        service.process.map((step, i) => (
          <li class="relative rounded-lg border border-stone-warm-200 bg-white p-6 pt-8">
            <span class="absolute -top-5 left-6 flex h-10 w-10 items-center justify-center rounded-full bg-cta-600 font-display text-xl font-bold text-white">
              {i + 1}
            </span>
            <h3 class="font-display text-xl font-bold text-brand-900">{step.title}</h3>
            <p class="mt-2 leading-relaxed text-brand-800/90">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <CtaSection heading={`Get a Free ${service.shortName} Inspection`} />

  <ReviewCarousel reviews={reviewsFor({ serviceSlug: service.slug, limit: 3 })} />

  <ProjectGallery limit={6} />

  <Faq faqs={service.faqs} heading={`${service.shortName} Questions`} />

  {
    comboCities.length > 0 && (
      <section class="container-site section-pad !pt-0">
        <h2 class="font-display text-2xl font-bold text-brand-900">{service.shortName} Near You</h2>
        <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
          {comboCities.map((city) => (
            <a href={`/service-areas/${city.slug}/${service.slug}/`} class="font-semibold text-cta-600 hover:underline">
              {service.shortName} in {city.name}, {city.state}
            </a>
          ))}
        </div>
      </section>
    )
  }

  <CtaSection
    heading="Talk To a Real Local Crew"
    body="Book online in under a minute, or call and a person — not a phone tree — picks up."
  />
</BaseLayout>
