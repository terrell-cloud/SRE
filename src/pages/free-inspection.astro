---
import BaseLayout from '@layouts/BaseLayout.astro';
import TrustBadges from '@components/TrustBadges.astro';
import { siteConfig } from '@data/siteConfig';
import { businessSchema } from '@lib/schema';
import { cities } from '@data/cities';

const seo = {
  title: 'Schedule a Free Roof Inspection | Southern Roofing & Exteriors',
  description:
    'Book your free, no-obligation roof inspection in under a minute. Full photo report and honest options for homes and businesses in NW Georgia and the Chattanooga area.',
  path: '/free-inspection/',
};

const calendarUrl = siteConfig.ghl.calendarUrl;
const schemas = [businessSchema(cities.map((c) => `${c.name}, ${c.state}`))];
---

<BaseLayout seo={seo} schemas={schemas}>
  <section class="bg-brand-900">
    <div class="container-site px-4 py-12 text-center md:py-16 lg:px-8">
      <h1 class="font-display text-4xl font-bold text-white md:text-5xl">
        Schedule Your Free Inspection
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-brand-100/95">
        Pick a time below and we'll be there — with photos, straight answers, and zero pressure.
        Takes about 30 minutes on site.
      </p>
      <div class="mt-6 flex justify-center"><TrustBadges light /></div>
    </div>
  </section>

  <section class="container-site px-4 py-10 lg:px-8">
    {
      calendarUrl ? (
        <iframe
          src={calendarUrl}
          title="Booking calendar — schedule your free inspection"
          loading="lazy"
          class="mx-auto h-[75vh] min-h-[36rem] w-full max-w-3xl rounded-lg border border-stone-warm-200 bg-white shadow-sm"
        />
      ) : (
        <div class="mx-auto max-w-2xl rounded-lg border border-stone-warm-200 bg-stone-warm-50 p-10 text-center">
          <h2 class="font-display text-3xl font-bold text-brand-900">Grab a time by phone</h2>
          <p class="mt-3 text-lg text-brand-800">
            Online booking is being connected. Call or text and we'll get you on the calendar in
            about a minute.
          </p>
          <a href={`tel:${siteConfig.phone.e164}`} class="btn-cta mt-6">
            Call {siteConfig.phone.display}
          </a>
          <p class="mt-4 text-sm text-brand-700/80">
            {siteConfig.hours[0].days}: {siteConfig.hours[0].display}
          </p>
        </div>
      )
    }
  </section>

  <section class="container-site px-4 pb-14 lg:px-8">
    <div class="mx-auto grid max-w-3xl gap-6 sm:grid-cols-3">
      <div class="text-center">
        <p class="font-display text-2xl font-bold text-brand-900">30 min</p>
        <p class="mt-1 text-sm text-brand-800/90">Typical time on site, start to finish</p>
      </div>
      <div class="text-center">
        <p class="font-display text-2xl font-bold text-brand-900">Photo report</p>
        <p class="mt-1 text-sm text-brand-800/90">You see exactly what we see on the roof</p>
      </div>
      <div class="text-center">
        <p class="font-display text-2xl font-bold text-brand-900">$0 · no strings</p>
        <p class="mt-1 text-sm text-brand-800/90">Honest options — even "you're fine for now"</p>
      </div>
    </div>
  </section>
</BaseLayout>
