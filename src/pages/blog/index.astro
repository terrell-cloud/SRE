---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import CtaSection from '@components/CtaSection.astro';
import { posts, formatPostDate } from '@lib/wp';
import { breadcrumbSchema } from '@lib/schema';

const seo = {
  title: 'Roofing Tips & Guides | Southern Roofing & Exteriors Blog',
  description:
    'Practical guides on roofing, storm damage, insurance claims, siding, windows, and gutters from the Southern Roofing & Exteriors team in Dalton, GA.',
  path: '/blog/',
};

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
];
---

<BaseLayout seo={seo} schemas={[breadcrumbSchema(crumbs)]}>
  <Breadcrumbs crumbs={crumbs} />
  <section class="container-site section-pad !pt-8">
    <p class="eyebrow">Straight answers</p>
    <h1 class="mt-1 font-display text-4xl font-bold text-brand-900 md:text-5xl">
      Roofing Tips &amp; Guides
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-brand-800">
      What we'd tell you across the kitchen table — written down. New posts every week.
    </p>

    <div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.slug}/`}
            class="group flex h-full flex-col rounded-lg border border-stone-warm-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
          >
            {post.categories.length > 0 && <p class="eyebrow">{post.categories[0]}</p>}
            <h2 class="mt-2 font-display text-2xl font-bold leading-snug text-brand-900 group-hover:text-cta-600">
              {post.title}
            </h2>
            <p class="mt-3 flex-1 leading-relaxed text-brand-800/90">{post.excerpt}</p>
            <p class="mt-4 text-sm text-brand-700/70">{formatPostDate(post.date)}</p>
          </a>
        ))
      }
    </div>
  </section>
  <CtaSection />
</BaseLayout>
