# ── GoHighLevel embeds ─────────────────────────────────────────────
# Paste values from your GHL account; every one is optional — when a
# value is empty the site falls back to click-to-call so nothing breaks.
# After changing env vars on Vercel/Netlify, trigger a redeploy.

# Booking calendar. In GHL: Calendars → your inspection calendar → Share →
# copy the iframe URL (looks like https://api.leadconnectorhq.com/widget/booking/XXXX)
PUBLIC_GHL_CALENDAR_URL=

# Chat widget. In GHL: Sites → Chat Widget → Get Code. Paste ONLY the
# script src (https://widgets.leadconnectorhq.com/loader.js) and the
# data-widget-id value from that snippet.
PUBLIC_GHL_CHAT_SRC=
PUBLIC_GHL_CHAT_WIDGET_ID=

# Reviews widget. In GHL: Reputation → Widget → copy the iframe/script URL.
PUBLIC_GHL_REVIEWS_SRC=

# ── WordPress (headless blog) ──────────────────────────────────────
# Where Openclaw publishes. After the migration this is the wp. subdomain.
WP_API_BASE=https://southernroofingandexteriors.com
