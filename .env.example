# Copy to .env (gitignored) or set as environment variables in the
# Claude Code environment settings. Never commit real values.

# Leap CRM (formerly JobProgress): Settings -> Developers -> Generate Token
LEAP_TOKEN=

# CompanyCam: profile icon -> Access Tokens -> + New Token (read-only is enough)
COMPANYCAM_TOKEN=

# GoHighLevel: sub-account Settings -> Private Integrations -> Create.
# Scopes: contacts.readonly, opportunities.readonly,
#         locations/customFields.readonly, users.readonly
GHL_TOKEN=
GHL_LOCATION_ID=
